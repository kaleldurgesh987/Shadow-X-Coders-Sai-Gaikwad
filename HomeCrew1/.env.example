# ============================================
# HomeCrew Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ============================================

# Firebase (Frontend - prefixed with VITE_)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Maps (Frontend)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Backend Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK (Backend - NEVER expose to frontend)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Maps (Backend - server-side key)
GOOGLE_MAPS_SERVER_API_KEY=your_server_side_maps_key

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
