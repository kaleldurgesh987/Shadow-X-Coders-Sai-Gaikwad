{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile for customer or worker",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "profileImage": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "worker", "admin"] },
        "location": { "type": "string" },
        "preferredLanguage": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "workerProfiles": {
      "title": "WorkerProfile",
      "description": "Public profile and rates for blue-collar workers",
      "type": "object",
      "properties": {
        "workerId": { "type": "string" },
        "name": { "type": "string" },
        "skills": { "type": "string" },
        "services": { "type": "string" },
        "experience": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "availability": { "type": "boolean" },
        "workingArea": { "type": "string" },
        "location": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "verificationStatus": { "type": "string", "enum": ["verified", "pending", "unverified"] },
        "averageRating": { "type": "number" },
        "totalReviews": { "type": "number" },
        "completedJobs": { "type": "number" },
        "whatsappNumber": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["workerId", "name", "hourlyRate"]
    },
    "jobs": {
      "title": "Job",
      "description": "Service request and booking details",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "service": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "scheduledAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "negotiating", "confirmed", "in_progress", "completed", "cancelled"] },
        "initialPrice": { "type": "number" },
        "finalPrice": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["customerId", "service", "status"]
    },
    "offers": {
      "title": "Offer",
      "description": "Price negotiation and counteroffer track",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "customerId": { "type": "string" },
        "workerId": { "type": "string" },
        "offeredAmount": { "type": "number" },
        "counterAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "countered", "accepted", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["jobId", "customerId", "workerId", "status"]
    },
    "messages": {
      "title": "Message",
      "description": "Real-time communication during job negotiation and tracking",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "message": { "type": "string" },
        "messageType": { "type": "string" },
        "timestamp": { "type": "string" },
        "readStatus": { "type": "boolean" }
      },
      "required": ["jobId", "senderId", "message"]
    },
    "reviews": {
      "title": "Review",
      "description": "Customer ratings and reviews for completed jobs",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "workerId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["jobId", "customerId", "workerId", "rating"]
    },
    "notifications": {
      "title": "Notification",
      "description": "In-app notifications for bookings, offers, and arrivals",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "relatedJobId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "users" },
      "description": "User profiles"
    },
    "/workerProfiles/{workerId}": {
      "schema": { "$ref": "workerProfiles" },
      "description": "Worker profiles and rates"
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "jobs" },
      "description": "Jobs and bookings"
    },
    "/offers/{offerId}": {
      "schema": { "$ref": "offers" },
      "description": "Job offers and negotiations"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "messages" },
      "description": "Job chat messages"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "reviews" },
      "description": "Customer reviews for workers"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "notifications" },
      "description": "User notifications"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "users" },
      "description": "Trusted admin records"
    }
  }
}
